{
  "name": "kat",
  "description": "File and stream concatenation the right way.",
  "keywords": [
    "file",
    "read",
    "stream",
    "concat"
  ],
  "version": "0.5.2",
  "repository": {
    "type": "git",
    "url": "git://github.com/fent/node-kat.git"
  },
  "author": "fent <fentbox@gmail.com> (https://github.com/fent)",
  "main": "./dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "tsc -p tsconfig.build.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "nyc --extension .ts --reporter=lcov --reporter=text-summary npm run test:unit && npm run test:package",
    "test:unit": "mocha --require ts-node/register --ignore test/export-test.ts test/*-test.ts",
    "test:package": "mocha --require ts-node/register test/export-test.ts"
  },
  "dependencies": {
    "queue2": "~0.2.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "mocha": "^12.0.3",
    "nyc": "^18.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
